NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Reserved for later phases; not read or required by the Phase 1 health server.
# Replace placeholders locally when database/auth implementation is approved.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace_with_local_user
MYSQL_PASSWORD=replace_with_local_password
MYSQL_DATABASE=placement_dev
MONGODB_URI=mongodb://127.0.0.1:27017/placement_dev
SESSION_SECRET=replace_with_random_session_secret
CSRF_SECRET=replace_with_random_csrf_secret
SESSION_MAX_AGE_MS=7200000
