NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Required for MySQL CLI operations; use a separate migration account when needed.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace_with_local_user
MYSQL_PASSWORD=replace_with_local_password
MYSQL_DATABASE=placement_dev
# An explicit database name is required; URL-encode credentials if authentication is enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/placement_dev
# Future authentication phase only; currently unused.
SESSION_SECRET=replace_with_random_session_secret
CSRF_SECRET=replace_with_random_csrf_secret
SESSION_MAX_AGE_MS=7200000
