{
  "name": "@placement/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint src scripts ../tests/backend ../tests/db ../tests/auth ../tests/business ../tests/outage vitest*.config.js --max-warnings 0",
    "format": "prettier --write src scripts package.json",
    "test": "vitest run --config vitest.config.js",
    "test:integration": "vitest run --config vitest.config.js ../tests/backend/integration",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "admin:create": "node --env-file-if-exists=.env scripts/createAdmin.js",
    "reconcile": "node scripts/notImplemented.js reconcile",
    "db:check": "node --env-file-if-exists=.env scripts/checkDatabases.js",
    "db:schema": "node scripts/schemaSnapshot.js",
    "mongo:setup": "node --env-file-if-exists=.env scripts/mongoSetup.js",
    "mongo:seed": "node --env-file-if-exists=.env scripts/mongoSeed.js",
    "test:db": "node --env-file-if-exists=.env.test ../node_modules/vitest/vitest.mjs run --config vitest.db.config.js",
    "test:db:services": "node scripts/startTestDatabases.js",
    "test:auth": "node --env-file-if-exists=.env.test ../node_modules/vitest/vitest.mjs run --config vitest.auth.config.js",
    "test:business": "node --env-file-if-exists=.env.test ../node_modules/vitest/vitest.mjs run --config vitest.business.config.js",
    "test:backend": "npm test && npm run test:db && npm run test:auth && npm run test:business",
    "test:outage": "node --env-file-if-exists=.env.test ../node_modules/vitest/vitest.mjs run --config vitest.outage.config.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
