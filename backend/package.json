{
  "name": "@placement/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint src scripts ../tests/backend vitest.config.js --max-warnings 0",
    "format": "prettier --write src scripts package.json",
    "test": "vitest run --config vitest.config.js",
    "test:integration": "vitest run --config vitest.config.js ../tests/backend/integration",
    "db:migrate": "node scripts/notImplemented.js db:migrate",
    "db:seed": "node scripts/notImplemented.js db:seed",
    "admin:create": "node scripts/notImplemented.js admin:create",
    "reconcile": "node scripts/notImplemented.js reconcile"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
