# Copy to .env.test only for existing disposable database instances.
# The optional test:db:services helper generates this file securely if absent.
# Both database names MUST end in _test; tests destroy their contents.
NODE_ENV=test
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=replace_with_test_database_user
MYSQL_PASSWORD=replace_with_test_database_password
MYSQL_DATABASE=placement_test
MONGODB_URI=mongodb://127.0.0.1:27018/placement_test

SESSION_SECRET=replace_with_unique_random_session_secret
CSRF_SECRET=replace_with_unique_random_csrf_secret
SESSION_MAX_AGE_MS=7200000

TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT=10
# Operator-only, set securely for one admin:create invocation; do not commit values.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
